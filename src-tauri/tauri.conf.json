{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Kiraeve Launcher",
  "version": "0.1.0",
  "identifier": "com.kiraeve.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kiraeve Launcher",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3RjAxN0FCNUE5MTAxMjcKUldRbkFaRmFxeGZ3bDRZSWptV2YwSTRHdW1obVpmNFgxdXpJMTZtcUcvMmxOT29qV01FL05PakwK",
      "endpoints": [
        "https://github.com/teamAsparagus/kiraeve-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
