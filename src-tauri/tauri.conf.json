{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Asparagus",
  "version": "1.0.3",
  "identifier": "com.asparagus.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Asparagus",
        "width": 540,
        "height": 380,
        "minWidth": 460,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3RjAxN0FCNUE5MTAxMjcKUldRbkFaRmFxeGZ3bDRZSWptV2YwSTRHdW1obVpmNFgxdXpJMTZtcUcvMmxOT29qV01FL05PakwK",
      "endpoints": [
        "https://pub-62352b30a9014afa94bda00163ab4d79.r2.dev/launcher/latest.json"
      ]
    }
  }
}
